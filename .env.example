# ================================================
#  QuizAI — Environment Variables Template
#  👉 এই ফাইল copy করে .env নামে save করো
#     তারপর নিজের values দিয়ে পূরণ করো
# ================================================

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=edtech_quiz_db

# JWT Secret (যেকোনো random string, কমপক্ষে ৩২ character)
JWT_SECRET=quizai_change_this_to_a_long_random_string

# Groq API Key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here